library project Backoff is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "backoff";
   --  Static: consumers link the objects in directly. A dylib would need
   --  rpath juggling on macOS (GNAT <= 14.2 emits duplicate LC_RPATH
   --  entries that dyld rejects at load time).
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-O2");
   end Compiler;
end Backoff;
